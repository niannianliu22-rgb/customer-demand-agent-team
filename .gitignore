.DS_Store

# Credentials and local environments
.env
.env.*
!.env.example
*.key
*.pem
*credential*
*secret*
*token*
.venv/
venv/

# Python and editor caches
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.vscode/
.idea/

# Runtime outputs: may contain customer data, raw model responses, audit logs, or paths.
runs/**
artifacts/**
quality/**
logs/**
*.log

# Business input and derived data
data/raw/**
data/standardized/**
data/output/**
!data/raw/.gitkeep
!data/standardized/.gitkeep
!data/output/.gitkeep

# Explicitly retain only synthetic and sanitized delivery fixtures.
!examples/
!examples/**
!demo/
!demo/**
